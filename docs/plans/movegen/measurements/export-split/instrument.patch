+//! Scratch export instrumentation. NOT part of the product; lives only in the
+//! probe tree. Every counter is reset immediately before `format::encode`
+//! and dumped immediately after, so the numbers describe the export walk.
+
+use std::cell::{Cell, RefCell};
+use std::collections::HashSet;
+
+macro_rules! decl {
+    ($($n:ident),* $(,)?) => {
+        thread_local! { $(pub static $n: Cell<u64> = const { Cell::new(0) };)* }
+    };
+}
+
+decl! {
+    JUDGE, JUDGE_WON, JUDGE_FAILED, JUDGE_OPEN,
+    WIT, WIT_SOME, WIT_NONE, WIT_REPLIES, WIT_IN_PROVEN, WIT_REPEAT, WIT_NONOPEN,
+    PROVE, PROVE_CANDS, PROVE_CHECKS, PROVE_MATE1, PROVE_WIT, PROVE_DEEP,
+    PLAY, LEGAL, LEGAL_MOVES, PSEUDO, INCHECK, ISLEGAL, REPLAY_CHECK,
+    HASLEGAL, CANNOTWIN,
+    CAPTURE_WINS, CAPTURE_CANDS, CAPTURE_PLAYS,
+    ATTACKER, ATTACKER_HIT, ATTACKER_REPROVE, DEFENDER,
+    TABLE_HIT, TABLE_MISS, TABLE_LEN_EQ, TABLE_LEN_NE, TABLE_LEN_DIFF, FAST_SKIP, FAST_FALLBACK,
+    CHECK_T1, CHECK_T2, CHECK_T3, CHECK_TNONE, CHECK_AGREE2, CHECK_MISS_WIT, CHECK_FALSE2, CHECK_TRUE2,
+    WIT_LEGAL_POS, WIT_LEGAL_REPLY, DEF_LEGAL, PROVE_LEGAL, ROOT_LEGAL,
+    PROVE_PLAY_CAND, PROVE_PLAY_DEEP, WIT_PLAY_REPLY, DEF_PLAY,
+}
+
+thread_local! {
+    static WIT_SEEN: RefCell<HashSet<u64>> = RefCell::new(HashSet::new());
+    static JUDGE_SEEN: RefCell<HashSet<(u64, u32)>> = RefCell::new(HashSet::new());
+    static PROVE_SEEN: RefCell<HashSet<u64>> = RefCell::new(HashSet::new());
+    static PLAY_SEEN: RefCell<HashSet<(u64, u16)>> = RefCell::new(HashSet::new());
+    static LEGAL_SEEN: RefCell<HashSet<u64>> = RefCell::new(HashSet::new());
+}
+
+macro_rules! bumpers {
+    ($($f:ident => $c:ident),* $(,)?) => {
+        $(
+            #[inline]
+            pub fn $f() { $c.with(|x| x.set(x.get() + 1)); }
+        )*
+    };
+}
+
+bumpers! {
+    judge => JUDGE,
+    judge_won => JUDGE_WON,
+    judge_failed => JUDGE_FAILED,
+    judge_open => JUDGE_OPEN,
+    wit => WIT,
+    wit_some => WIT_SOME,
+    wit_none => WIT_NONE,
+    wit_in_proven => WIT_IN_PROVEN,
+    wit_repeat => WIT_REPEAT,
+    wit_nonopen => WIT_NONOPEN,
+    prove => PROVE,
+    prove_cands => PROVE_CANDS,
+    prove_checks => PROVE_CHECKS,
+    prove_mate1 => PROVE_MATE1,
+    prove_wit => PROVE_WIT,
+    prove_deep => PROVE_DEEP,
+    play => PLAY,
+    legal => LEGAL,
+    pseudo => PSEUDO,
+    incheck => INCHECK,
+    islegal => ISLEGAL,
+    replay_check => REPLAY_CHECK,
+    haslegal => HASLEGAL,
+    cannotwin => CANNOTWIN,
+    capture_wins => CAPTURE_WINS,
+    capture_cands => CAPTURE_CANDS,
+    capture_plays => CAPTURE_PLAYS,
+    attacker => ATTACKER,
+    attacker_hit => ATTACKER_HIT,
+    attacker_reprove => ATTACKER_REPROVE,
+    defender => DEFENDER,
+    table_hit => TABLE_HIT,
+    table_miss => TABLE_MISS,
+    table_len_eq => TABLE_LEN_EQ,
+    table_len_ne => TABLE_LEN_NE,
+    fast_skip => FAST_SKIP,
+    fast_fallback => FAST_FALLBACK,
+    check_t1 => CHECK_T1,
+    check_t2 => CHECK_T2,
+    check_t3 => CHECK_T3,
+    check_tnone => CHECK_TNONE,
+    check_agree2 => CHECK_AGREE2,
+    check_miss_wit => CHECK_MISS_WIT,
+    check_false2 => CHECK_FALSE2,
+    check_true2 => CHECK_TRUE2,
+    wit_legal_pos => WIT_LEGAL_POS,
+    wit_legal_reply => WIT_LEGAL_REPLY,
+    def_legal => DEF_LEGAL,
+    prove_legal => PROVE_LEGAL,
+    root_legal => ROOT_LEGAL,
+    prove_play_cand => PROVE_PLAY_CAND,
+    prove_play_deep => PROVE_PLAY_DEEP,
+    wit_play_reply => WIT_PLAY_REPLY,
+    def_play => DEF_PLAY,
+}
+
+#[inline]
+pub fn add_legal_moves(n: u64) {
+    LEGAL_MOVES.with(|x| x.set(x.get() + n));
+}
+#[inline]
+pub fn add_table_len_diff(n: u64) {
+    TABLE_LEN_DIFF.with(|x| x.set(x.get() + n));
+}
+#[inline]
+pub fn add_wit_replies(n: u64) {
+    WIT_REPLIES.with(|x| x.set(x.get() + n));
+}
+
+/// True when this wins_in_two position was already asked in this walk.
+pub fn wit_seen(h: u64) -> bool {
+    WIT_SEEN.with(|s| !s.borrow_mut().insert(h))
+}
+/// True when this (hash, counter) was already judged in this walk.
+pub fn judge_seen(h: u64, c: u32) -> bool {
+    JUDGE_SEEN.with(|s| !s.borrow_mut().insert((h, c)))
+}
+/// True when this hash was already proven in this walk.
+pub fn prove_seen(h: u64) -> bool {
+    PROVE_SEEN.with(|s| !s.borrow_mut().insert(h))
+}
+/// True when this (parent hash, move bits) was already played in this walk.
+pub fn play_seen(h: u64, m: u16) -> bool {
+    PLAY_SEEN.with(|s| !s.borrow_mut().insert((h, m)))
+}
+/// True when this hash's legal move list was already built in this walk.
+pub fn legal_seen(h: u64) -> bool {
+    LEGAL_SEEN.with(|s| !s.borrow_mut().insert(h))
+}
+
+macro_rules! all_counters {
+    ($m:ident $(, $arg:expr)*) => {
+        $m!($($arg,)* JUDGE, JUDGE_WON, JUDGE_FAILED, JUDGE_OPEN, WIT, WIT_SOME, WIT_NONE,
+            WIT_REPLIES, WIT_IN_PROVEN, WIT_REPEAT, WIT_NONOPEN, PROVE, PROVE_CANDS,
+            PROVE_CHECKS, PROVE_MATE1, PROVE_WIT, PROVE_DEEP, PLAY, LEGAL, LEGAL_MOVES,
+            PSEUDO, INCHECK, ISLEGAL, REPLAY_CHECK, HASLEGAL, CANNOTWIN, CAPTURE_WINS,
+            CAPTURE_CANDS, CAPTURE_PLAYS, ATTACKER, ATTACKER_HIT, ATTACKER_REPROVE,
+            DEFENDER, TABLE_HIT, TABLE_MISS, TABLE_LEN_EQ, TABLE_LEN_NE, TABLE_LEN_DIFF,
+            FAST_SKIP, FAST_FALLBACK, CHECK_T1, CHECK_T2, CHECK_T3, CHECK_TNONE,
+            CHECK_AGREE2, CHECK_MISS_WIT, CHECK_FALSE2, CHECK_TRUE2, WIT_LEGAL_POS,
+            WIT_LEGAL_REPLY, DEF_LEGAL, PROVE_LEGAL, ROOT_LEGAL, PROVE_PLAY_CAND,
+            PROVE_PLAY_DEEP, WIT_PLAY_REPLY, DEF_PLAY);
+    };
+}
+
+macro_rules! zero {
+    ($($c:ident),*) => { $( $c.with(|x| x.set(0)); )* };
+}
+macro_rules! emit {
+    ($out:expr, $($c:ident),*) => {
+        $( $out.push_str(&format!("\"{}\":{},", stringify!($c), $c.with(|x| x.get()))); )*
+    };
+}
+
+pub fn reset() {
+    all_counters!(zero);
+    WIT_SEEN.with(|s| s.borrow_mut().clear());
+    JUDGE_SEEN.with(|s| s.borrow_mut().clear());
+    PROVE_SEEN.with(|s| s.borrow_mut().clear());
+    PLAY_SEEN.with(|s| s.borrow_mut().clear());
+    LEGAL_SEEN.with(|s| s.borrow_mut().clear());
+}
+
+pub fn dump() {
+    let mut out = String::from("{\"export_counters\":{");
+    all_counters!(emit, out);
+    let wit_unique = WIT_SEEN.with(|s| s.borrow().len());
+    let judge_unique = JUDGE_SEEN.with(|s| s.borrow().len());
+    let prove_unique = PROVE_SEEN.with(|s| s.borrow().len());
+    let play_unique = PLAY_SEEN.with(|s| s.borrow().len());
+    let legal_unique = LEGAL_SEEN.with(|s| s.borrow().len());
+    out.push_str(&format!(
+        "\"WIT_UNIQUE\":{wit_unique},\"JUDGE_UNIQUE\":{judge_unique},\"PROVE_UNIQUE\":{prove_unique},\"PLAY_UNIQUE\":{play_unique},\"LEGAL_UNIQUE\":{legal_unique}"
+    ));
+    out.push_str("}}");
+    eprintln!("{out}");
+}
