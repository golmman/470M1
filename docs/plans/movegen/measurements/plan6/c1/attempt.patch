+/// The rules geometry of one node, read once from the prover's board so the
+/// per-candidate queries do not re-enter it for the occupancy, the colour
+/// masks, the kings or the role masks. Built once per expanded node; a child's
+/// facts are never carried from its parent.
+#[derive(Clone, Copy)]
+pub struct NodeFacts {
+    occupied: Bitboard,
+    /// Pieces by colour, indexed by `Color`'s own discriminant.
+    colors: [Bitboard; 2],
+    /// Pieces by role, indexed by `Role`'s own discriminant; slot 0 is empty.
+    roles: [Bitboard; 7],
+    /// The two kings' squares, one bit per colour.
+    kings: [Bitboard; 2],
+}
+
+impl NodeFacts {
+    pub fn of(pos: &Position) -> NodeFacts {
+        let board = pos.board();
+        let mut roles = [Bitboard::EMPTY; 7];
+        for role in Role::ALL {
+            roles[role as usize] = Bitboard(board.pieces_pt(native_role(role)).0);
+        }
+        let mut colors = [Bitboard::EMPTY; 2];
+        for color in Color::ALL {
+            colors[color as usize] = Bitboard(board.pieces_color(native_color(color)).0);
+        }
+        let kings = roles[Role::King as usize];
+        NodeFacts {
+            occupied: Bitboard(board.occupied().0),
+            colors,
+            roles,
+            kings: [
+                kings & colors[Color::Black as usize],
+                kings & colors[Color::White as usize],
+            ],
+        }
+    }
+
+    #[inline]
+    pub fn occupied(&self) -> Bitboard {
+        self.occupied
+    }
+
+    #[inline]
+    pub fn by_color(&self, color: Color) -> Bitboard {
+        self.colors[color as usize]
+    }
+
+    #[inline]
+    pub fn by_role(&self, role: Role) -> Bitboard {
+        self.roles[role as usize]
+    }
+
+    #[inline]
+    pub fn by_piece(&self, piece: Piece) -> Bitboard {
+        self.by_color(piece.color) & self.by_role(piece.role)
+    }
+
+    #[inline]
+    pub fn king(&self, color: Color) -> Option<Square> {
+        self.kings[color as usize].first()
+    }
+}
