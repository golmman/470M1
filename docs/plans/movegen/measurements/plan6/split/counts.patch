diff -ruN a/src/counts.rs b/src/counts.rs
--- a/src/counts.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/src/counts.rs	2026-11-19 22:41:27.188548346 +0000
@@ -0,0 +1,38 @@
+//! TEMPORARY measurement instrument (plan 6, Phase A): per-site call counters.
+//! Not for commit; timing must never be read from this build.
+
+use std::sync::atomic::{AtomicU64, Ordering};
+
+pub const SITES: [&str; 15] = [
+    "legal",
+    "effect",
+    "pseudo_legal",
+    "play",
+    "null",
+    "mover_new",
+    "plain",
+    "exposes",
+    "gives_check",
+    "threats",
+    "terms",
+    "replay_threat",
+    // supplementary: the hot entry points the 12 sites above only reach
+    "mover_legal",
+    "attackers_to",
+    "context_legal",
+];
+
+static COUNTS: [AtomicU64; 15] = [const { AtomicU64::new(0) }; 15];
+
+#[inline]
+pub fn bump(site: usize) {
+    COUNTS[site].fetch_add(1, Ordering::Relaxed);
+}
+
+pub fn snapshot() -> Vec<(&'static str, u64)> {
+    SITES
+        .iter()
+        .zip(COUNTS.iter())
+        .map(|(name, count)| (*name, count.load(Ordering::Relaxed)))
+        .collect()
+}
