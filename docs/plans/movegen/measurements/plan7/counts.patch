+//! TEMPORARY measurement instrument (plan 7, Phase A): eval geometry counts.
+//! Not for commit; timing must never be read from this build.
+
+use std::sync::atomic::{AtomicU64, Ordering};
+
+use shakmaty::Role;
+
+use crate::board::Position;
+
+/// Histogram shape: pieces 0..=32, roles 0..=5.
+const SLOTS: usize = 33 * 6;
+
+static TERMS: AtomicU64 = AtomicU64::new(0);
+static ATTACKS: AtomicU64 = AtomicU64::new(0);
+static PIECES: AtomicU64 = AtomicU64::new(0);
+static ROLES: AtomicU64 = AtomicU64::new(0);
+static EVALS: AtomicU64 = AtomicU64::new(0);
+static EVAL_PIECES: AtomicU64 = AtomicU64::new(0);
+static EVAL_ROLES: AtomicU64 = AtomicU64::new(0);
+/// Per `evaluate`: total non-king pieces (both sides) and defender roles.
+static EVAL_HIST: [AtomicU64; SLOTS] = [const { AtomicU64::new(0) }; SLOTS];
+/// Per `terms` call: that side's non-king pieces and roles present.
+static SIDE_HIST: [AtomicU64; SLOTS] = [const { AtomicU64::new(0) }; SLOTS];
+
+#[inline]
+fn bump(counter: &AtomicU64) {
+    counter.fetch_add(1, Ordering::Relaxed);
+}
+
+#[inline]
+fn add(counter: &AtomicU64, value: u64) {
+    counter.fetch_add(value, Ordering::Relaxed);
+}
+
+#[inline]
+pub fn terms(pieces: u32, roles: u32) {
+    bump(&TERMS);
+    add(&PIECES, u64::from(pieces));
+    add(&ROLES, u64::from(roles));
+    let slot = usize::try_from(pieces).unwrap().min(32) * 6 + usize::try_from(roles).unwrap().min(5);
+    bump(&SIDE_HIST[slot]);
+}
+
+#[inline]
+pub fn attacks() {
+    bump(&ATTACKS);
+}
+
+/// One `eval::evaluate`: total pieces and the defender's distinct role masks.
+#[inline]
+pub fn eval(pos: &Position) {
+    let occupied = pos.occupied();
+    let kings = pos.by_role(Role::King);
+    let pieces = (occupied & !kings).count() as u32;
+    let theirs = pos.by_color(!pos.turn()) & !kings;
+    let mut roles = 0u32;
+    for role in [Role::Pawn, Role::Knight, Role::Bishop, Role::Rook, Role::Queen] {
+        if (theirs & pos.by_role(role)).any() {
+            roles += 1;
+        }
+    }
+    bump(&EVALS);
+    add(&EVAL_PIECES, u64::from(pieces));
+    add(&EVAL_ROLES, u64::from(roles));
+    let slot = usize::try_from(pieces).unwrap().min(32) * 6 + usize::try_from(roles).unwrap().min(5);
+    bump(&EVAL_HIST[slot]);
+}
+
+fn hist(values: &[AtomicU64; SLOTS], pieces: &str, roles: &str) -> serde_json::Value {
+    let mut out = Vec::new();
+    for n in 0..33usize {
+        for r in 0..6usize {
+            let count = values[n * 6 + r].load(Ordering::Relaxed);
+            if count > 0 {
+                out.push(serde_json::json!({pieces: n, roles: r, "calls": count}));
+            }
+        }
+    }
+    serde_json::Value::Array(out)
+}
+
+pub fn snapshot() -> serde_json::Value {
+    serde_json::json!({
+        "terms": TERMS.load(Ordering::Relaxed),
+        "attacks": ATTACKS.load(Ordering::Relaxed),
+        "terms_pieces": PIECES.load(Ordering::Relaxed),
+        "terms_roles": ROLES.load(Ordering::Relaxed),
+        "evals": EVALS.load(Ordering::Relaxed),
+        "eval_pieces": EVAL_PIECES.load(Ordering::Relaxed),
+        "eval_roles": EVAL_ROLES.load(Ordering::Relaxed),
+        "eval_hist": hist(&EVAL_HIST, "pieces", "roles"),
+        "terms_hist": hist(&SIDE_HIST, "pieces", "roles"),
+    })
+}
