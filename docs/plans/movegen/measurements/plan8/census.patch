+/// Temporary census counters (plan 8, scratch tree only).
+pub mod census {
+    use super::{AtomicU64, BTreeMap, Ordering};
+    static CALLS: AtomicU64 = AtomicU64::new(0);
+    static FAST: AtomicU64 = AtomicU64::new(0);
+    static CAPTURE: AtomicU64 = AtomicU64::new(0);
+    static QUIET: AtomicU64 = AtomicU64::new(0);
+    static KING: AtomicU64 = AtomicU64::new(0);
+    static IN_CHECK: AtomicU64 = AtomicU64::new(0);
+    static TRIVIAL: AtomicU64 = AtomicU64::new(0);
+    static TERMINAL: AtomicU64 = AtomicU64::new(0);
+    static SOME_TRUE: AtomicU64 = AtomicU64::new(0);
+    static SOME_FALSE: AtomicU64 = AtomicU64::new(0);
+    static NONE_ORACLE: AtomicU64 = AtomicU64::new(0);
+    static IN_CHECK_ORACLE: AtomicU64 = AtomicU64::new(0);
+    fn bump(c: &AtomicU64) { c.fetch_add(1, Ordering::Relaxed); }
+    pub fn calls() { bump(&CALLS); }
+    pub fn fast() { bump(&FAST); }
+    pub fn site_capture() { bump(&CAPTURE); }
+    pub fn site_quiet() { bump(&QUIET); }
+    pub fn site_king() { bump(&KING); }
+    pub fn site_in_check() { bump(&IN_CHECK); }
+    pub fn trivial() { bump(&TRIVIAL); }
+    pub fn terminal() { bump(&TERMINAL); }
+    pub fn some_true() { bump(&SOME_TRUE); }
+    pub fn some_false() { bump(&SOME_FALSE); }
+    pub fn none_oracle() { bump(&NONE_ORACLE); }
+    pub fn in_check_oracle() { bump(&IN_CHECK_ORACLE); }
+    pub fn snapshot() -> BTreeMap<&'static str, u64> {
+        [
+            ("calls", &CALLS), ("fast", &FAST), ("site_capture", &CAPTURE),
+            ("site_quiet", &QUIET), ("site_king", &KING), ("site_in_check", &IN_CHECK),
+            ("trivial", &TRIVIAL), ("terminal", &TERMINAL), ("some_true", &SOME_TRUE),
+            ("some_false", &SOME_FALSE), ("none_oracle", &NONE_ORACLE),
+            ("in_check_oracle", &IN_CHECK_ORACLE),
+        ].into_iter().map(|(k, c)| (k, c.load(Ordering::Relaxed))).collect()
+    }
+}
