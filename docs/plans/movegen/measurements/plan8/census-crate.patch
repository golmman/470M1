+/// Which rung of the fast-legality ladder answered a candidate.
+///
+/// Diagnostic only: [`FastLegality::legal_in`] does not expose it, so a normal
+/// caller never pays for the classification.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum LegalStage {
+    /// Terminal board: no move is legal.
+    Terminal,
+    /// Side to move is in check: the oracle answered.
+    InCheck,
+    /// The trivial quiet fast path accepted the move.
+    Trivial,
+    /// The widened rules decided the move; the value is the verdict.
+    Widened(bool),
+    /// The widened rules could not decide; the oracle answered.
+    Oracle,
+}
+
+impl FastLegality {
+    /// The trivial rung alone, for a diagnostic screen.
+    #[must_use]
+    pub fn is_trivial(&self, m: Move) -> bool {
+        self.trivial.is_trivially_legal(m)
+    }
+
+    /// The widened rung alone, or `None` when it cannot decide or is not
+    /// applicable (in check, terminal, non-castling precondition).
+    #[must_use]
+    pub fn widened_verdict(
+        &self,
+        board: &Board,
+        m: Move,
+        state: &StateInfo,
+    ) -> Option<bool> {
+        if !self.playable || self.in_check || self.trivial.is_trivially_legal(m) {
+            return None;
+        }
+        let view = board.position_view();
+        let widened = self.widened.get_or_init(|| WidenedLegality::new(view));
+        widened.decide(view, m)
+    }
+
+    /// [`legal_in`](Self::legal_in) with the answering rung reported.
+    ///
+    /// Mirrors the ladder branch for branch; the oracle is called exactly
+    /// where [`legal_in`](Self::legal_in) calls it.
+    #[must_use]
+    pub fn legal_traced(&self, board: &Board, m: Move, state: &StateInfo) -> (bool, LegalStage) {
+        if self.trivial.is_trivially_legal(m) {
+            return (true, LegalStage::Trivial);
+        }
+        if !self.playable {
+            return (false, LegalStage::Terminal);
+        }
+        let view = board.position_view();
+        if self.in_check {
+            return (
+                crate::position::legal_in_view(view, m, state),
+                LegalStage::InCheck,
+            );
+        }
+        let widened = self.widened.get_or_init(|| WidenedLegality::new(view));
+        match widened.decide(view, m) {
+            Some(verdict) => (verdict, LegalStage::Widened(verdict)),
+            None => (
+                crate::position::legal_in_view(view, m, state),
+                LegalStage::Oracle,
+            ),
+        }
+    }
+}
 
